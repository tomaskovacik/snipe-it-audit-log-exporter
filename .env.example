# Copy to .env and adjust:  cp .env.example .env
# Every variable also accepts a *_FILE variant (e.g. SNIPEIT_API_TOKEN_FILE) for Docker/K8s secrets.

# --- Snipe-IT ---------------------------------------------------------------
SNIPEIT_URL=https://snipeit.example.com
# API token of a (read-only) user allowed to view reports/activity
SNIPEIT_API_TOKEN=changeme
#SNIPEIT_API_TOKEN_FILE=/run/secrets/snipeit_api_token
SNIPEIT_VERIFY_TLS=true
# Must match APP_TIMEZONE of Snipe-IT (API returns local times without offset)
SNIPEIT_TIMEZONE=UTC

# --- Polling ----------------------------------------------------------------
# Seconds between polls
POLL_INTERVAL=60
# Rows per request (capped by Snipe-IT MAX_RESULTS, default 500)
PAGE_SIZE=500
# Minimum seconds between API calls (Snipe-IT throttles at 120 req/min by default)
REQUEST_DELAY=0.6
# First run only: beginning = full history backfill, now = only new events
START_FROM=beginning
# Re-check this many ids below the cursor each poll (late-committed rows)
LOOKBACK_IDS=100
STATE_FILE=/data/state.json

# --- Output -----------------------------------------------------------------
# gelf | stdout
OUTPUT=gelf
# Graylog on the same Docker host: use host.docker.internal (not localhost)
GRAYLOG_HOST=graylog.example.com
GRAYLOG_PORT=12201
# tcp | udp | http
GRAYLOG_PROTOCOL=tcp
GRAYLOG_TLS=false
GRAYLOG_VERIFY_TLS=true
# Only used with GRAYLOG_PROTOCOL=http
GRAYLOG_HTTP_PATH=/gelf
# Only used with GRAYLOG_PROTOCOL=udp
GELF_UDP_CHUNK_SIZE=1420

# --- GELF message -----------------------------------------------------------
# Graylog "source" field; defaults to the Snipe-IT hostname
#GELF_SOURCE=snipe-it
# Static extra fields as JSON object
GELF_EXTRA_FIELDS={"environment":"prod"}
# Put the full API record into full_message
GELF_INCLUDE_RAW=true

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=INFO
